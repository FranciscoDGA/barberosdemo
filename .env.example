# ============================================================================
# BarberOS — Variáveis de Ambiente
# ============================================================================
# Copie este arquivo para .env.local e preencha os valores.
#
# Guia completo: docs/TEMPLATE-GUIDE.md
# ============================================================================

# --- Supabase (obrigatório) ---
# Crie um projeto em https://supabase.com e copie as credenciais abaixo.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Google Gemini AI (obrigatório para Alfred) ---
# Crie uma API key em https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# --- URL do App (obrigatório para PWA e links) ---
# Produção: https://seu-dominio.com
# Preview: https://seu-app.vercel.app
NEXT_PUBLIC_APP_URL=https://seu-app.vercel.app

# --- WhatsApp (opcional — para notificações e bot) ---
# Uazapi: https://uazapi.com
# Z-API: https://z-api.io
NEXT_PUBLIC_UAZAPI_URL=https://api.uazapi.com
UAZAPI_TOKEN=seu-token-aqui
NEXT_PUBLIC_UAZAPI_INSTANCE=seu-instancia
NEXT_PUBLIC_ZAPI_URL=https://api.z-api.io
ZAPI_TOKEN=seu-token-aqui
ZAPI_INSTANCE_ID=seu-instance-id
ZAPI_INSTANCE_TOKEN=seu-instance-token
